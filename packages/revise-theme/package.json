{
  "name": "@inneranimalmedia/revise-theme",
  "version": "0.2.0",
  "description": "Revise: portable cinematic editorial commerce theme with directed scroll composition, overlays, motion grammar, and reusable presets.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/runtime/register.d.ts",
      "default": "./dist/runtime/register.js"
    },
    "./theme.json": "./dist/theme.json",
    "./capabilities.json": "./dist/capabilities.json",
    "./compatibility.json": "./dist/compatibility.json",
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./presets/foundation": "./dist/presets/foundation.json",
    "./presets/sections/media-hero/sticky-curtain": "./dist/presets/media-hero.sticky-curtain.json",
    "./presets/sections/statement/editorial": "./dist/presets/statement.editorial.json",
    "./runtime": {
      "types": "./dist/runtime/enhance.d.ts",
      "default": "./dist/runtime/enhance.js"
    },
    "./overlay-manager": {
      "types": "./dist/runtime/overlay-manager.d.ts",
      "default": "./dist/runtime/overlay-manager.js"
    },
    "./showcase": {
      "types": "./dist/presets/showcase.d.ts",
      "default": "./dist/presets/showcase.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@inneranimalmedia/site-contracts": "^0.1.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
