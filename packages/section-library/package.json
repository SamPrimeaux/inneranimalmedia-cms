{
  "name": "@inneranimalmedia/section-library",
  "version": "0.1.0",
  "description": "Generic semantic section renderers and shared layout geometry. Themes provide character; apps provide data.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout.css": "./dist/layout.css",
    "./specimens.css": "./dist/specimens.css",
    "./specimens-motion.js": "./dist/specimens-motion.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "test": "npm run build && vitest run && node --test scripts/specimens-check.mjs"
  },
  "dependencies": {
    "@inneranimalmedia/site-contracts": "^0.1.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}