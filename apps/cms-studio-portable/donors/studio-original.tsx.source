  "--radius-lg": "24px",
  "--space-section": "88px",
};

const section = (id, name, zone, type, fields, style = {}) => ({
  id,
  section_name: name,
  zone,
  type,
  is_visible: true,
  fields,
  style: {
    backgroundType: "solid",
    background: zone === "header" || zone === "footer" ? "#11131a" : "#ffffff",
    textColor: zone === "header" || zone === "footer" ? "#f4f6ff" : "#17181c",
    paddingY: zone === "header" ? 20 : 76,
    paddingX: 48,
    radius: 0,
    shadow: "none",
    opacity: 100,
    align: "left",
    fontSize: type === "hero" ? 64 : 40,
    lineHeight: 1.05,
    letterSpacing: -1.8,
    maxWidth: 1180,
    ...style,
  },
});

